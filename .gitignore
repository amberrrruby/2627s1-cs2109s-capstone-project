# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Jupyter-generated checkpoints
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Test, type-checker, and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Local virtual environments and packaging output
.venv/
venv/
env/
build/
dist/
*.egg-info/

# Editor and operating-system clutter
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
*~
*.tmp

# Keep project evidence and distributable model artifacts tracked. In
# particular, do not ignore history/, telemetry/, notebooks, *.pt, or the
# generated inline model loader.
